# MY.STUDY production environment
APP_ENV=production
COOKIE_SECURE=true
PORT=3000

# PostgreSQL. Keep PostgreSQL bound to localhost/private network only.
DATABASE_URL=postgres://kirill_study:CHANGE_DATABASE_PASSWORD@127.0.0.1:5432/kirill_study?sslmode=disable
DB_MAX_CONNS=6

# Initial admin account. The password is read only to create the first admin.
# It is stored in PostgreSQL only as a salted PBKDF2-SHA256 hash.
# After the first successful login you can remove ADMIN_PASSWORD from this file.
ADMIN_NAME=Кирилл
ADMIN_EMAIL=kirr.ignat@gmail.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
# ADMIN_TELEGRAM=@kirill_ignat

# Weekly tutoring slots. Weekdays: 1=Monday ... 7=Sunday.
BOOKING_TIMEZONE=Europe/Moscow
BOOKING_SCHEDULE='2=18:00,19:30,21:00;4=18:00,19:30,21:00;6=12:00,13:30,15:00'

# Optional fallback external conference link.
# DEFAULT_MEETING_URL=https://meet.google.com/your-room

# Self-hosted Jitsi Meet integration. JITSI_APP_SECRET must match JWT_APP_SECRET
# on the Jitsi deployment. Leave these commented to disable embedded conferences.
# JITSI_PUBLIC_URL=https://meet.example.com
# JITSI_APP_ID=my-study
# JITSI_APP_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
# JIBRI_RECORDINGS_DIR=/var/lib/my-study/jitsi/storage/jibri/recordings

# Optional Telegram push. Internal notifications work without Telegram.
# TELEGRAM_BOT_TOKEN=123456:YOUR_BOT_TOKEN
# TELEGRAM_CHAT_ID=YOUR_CHAT_ID
